# ============================================================
# 灵犀 环境变量模板（宝塔部署）
# 用法：cp .env.example .env 后逐项修改；完整步骤见 README-部署.md
# 运行方式：waitress 监听 127.0.0.1:8000，由 Nginx 反代对外提供 HTTPS
# ============================================================

# ===== 基础安全 =====
SECRET_KEY=please-generate-a-random-50-char-string
SESSION_COOKIE_SECURE=1

# ===== MySQL =====
# 可留空：首次启动后访问 /setup 网页安装向导填写（保存自动写入本文件，无需重启）
# 留空启动时应用进入安装向导模式，不会因连不上库而崩溃
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_bot
MYSQL_PASSWORD=your-password
MYSQL_DB=ai_bot
# Docker 自包含 MySQL 容器的 root 密码（仅 docker compose 方案用，宝塔方案用不到）
MYSQL_ROOT_PASSWORD=change-me-too
# Docker 方案宿主端口映射（80/443 被占用时修改）
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ===== AI（OpenAI 兼容，默认 DeepSeek）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90

# ===== 通知渠道 =====
# Server酱 SendKey（https://sct.ftqq.com/ 获取）
SC_KEY=
# 飞书群机器人 Webhook（可选加签）
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
# 飞书应用机器人（双向：接收消息 + API 发送，见设置页「飞书机器人」）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EVENT_TOKEN=
FEISHU_EVENT_ENCRYPT_KEY=
# 默认推送渠道，逗号分隔：inapp,serverchan,feishu
DEFAULT_CHANNELS=inapp

# ===== 管理员（首次初始化时创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# ===== 运行 =====
APP_TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLED=1
LOG_LEVEL=INFO

# ===== 域名体系（后台与网页域名分离，也可在设置页「域名设置」修改）=====
# 后台域名（AiBot 管理后台）；留空不限制访问域名
ADMIN_DOMAIN=
# AI 网页域名（生成的公开网站从此域名访问：https://网页域名/<slug>）；留空则用当前主机 /p/<slug>
PAGE_DOMAIN=

# ===== 图片生成（OpenAI 兼容 images 接口，也可在设置页「图片生成」修改）=====
# 如硅基流动 https://api.siliconflow.cn/v1（模型如 black-forest-labs/FLUX.1-schnell、
# Kwai-Kolors/Kolors），或任何 OpenAI 兼容图片服务
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# 默认尺寸（宽x高），常用 1024x1024 / 720x1280 / 1280x720
IMAGE_SIZE=1024x1024

# ===== 视觉模型（多模态识图，OpenAI 兼容 chat/completions + 图片输入，也可在设置页「视觉模型」修改）=====
# 独立于沟通模型与图片生成模型；未配置时收到图片仅保存、不识别
# 如 GPT-4o / 通义千问 VL（qwen-vl-max）等支持图片输入的多模态模型
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== 语音（OpenAI 兼容 TTS 接口，也可在设置页「语音」修改；未配置时前端用浏览器朗读）=====
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy

# ===== RAG 语义检索（OpenAI 兼容 embeddings 接口，未配置时自动降级为关键词搜索）=====
# 如硅基流动 https://api.siliconflow.cn/v1（模型如 BAAI/bge-m3）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== 联网搜索（可插拔提供方，也可在设置页「联网搜索」修改）=====
# duckduckgo（默认，免 key 开箱即用）/ searxng（自托管）/ serper（https://serper.dev）/ tavily（https://tavily.com）
SEARCH_PROVIDER=duckduckgo
SEARXNG_BASE_URL=
SERPER_API_KEY=
TAVILY_API_KEY=
