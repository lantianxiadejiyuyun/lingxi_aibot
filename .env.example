# ===== 基础安全 =====
SECRET_KEY=please-generate-a-random-50-char-string
SESSION_COOKIE_SECURE=1

# ===== App 对接 API（消费统计等）=====
# 可选全局回退 Token（记到第一个管理员）。推荐在网页「设置 → 账号」为每个用户生成独立 Token。
# 用户 Token 与此处都未配置时，/api/v1/* 一律 401。最短 16 位，过短视为未配置。
API_TOKEN=
# 允许把 LLM/图片/TTS 等接口指到本机或局域网（Ollama 等）。默认关，防止 SSRF。
# ALLOW_LOCAL_PROVIDERS=1

# ===== MySQL =====
# 应用与 MySQL 同一台：127.0.0.1
# 应用在 Docker、MySQL 在宿主机：host.docker.internal
# 使用 compose --profile mysql：db（不要写 127.0.0.1）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_bot
MYSQL_PASSWORD=your-password
MYSQL_DB=ai_bot
# 仅 Docker 自带 MySQL（--profile mysql）时需要；可与 MYSQL_PASSWORD 相同
# MYSQL_ROOT_PASSWORD=

# ===== AI =====
# 运行时每位用户在网页「设置 → 模型与人设」填写自己的 Key（不共用本文件的 Key）。
# 下面三项仅作安装向导/首个管理员的初始值。
# LLM_PROTOCOL=openai   # openai=OpenAI 兼容 chat.completions；anthropic=Claude Messages API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90

# ===== 通知渠道 =====
# Server酱 SendKey（https://sct.ftqq.com/ 获取）
SC_KEY=
# 飞书群机器人 Webhook（可选加签）
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
# 飞书应用机器人（双向：接收消息 + API 发送，见设置页「飞书机器人」）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EVENT_TOKEN=
FEISHU_EVENT_ENCRYPT_KEY=
# 收消息接入：callback（HTTP 回调，需公网 HTTPS）或 sdk（官方 lark-oapi 长连接，无需公网回调）
FEISHU_RECEIVE_MODE=callback
# 默认推送渠道，逗号分隔：inapp,serverchan,feishu
DEFAULT_CHANNELS=inapp

# ===== 管理员（首次初始化时创建）=====
ADMIN_USERNAME=admin
# 留空时 CLI 初始化生成随机初始密码并打印一次；也可自行设置强密码。
ADMIN_PASSWORD=

# ===== 运行 =====
APP_TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLED=1
LOG_LEVEL=INFO

# ===== 访问路径（不再使用独立后台域名 / 网页域名）=====
# 后台短入口：设置后后台为 http://主机:端口/<入口>/login ；留空则 /login
ADMIN_ENTRY=
# 生成的网页固定为 /webs/html/<slug>，局域网 IP 可直达
# 可选：再开一个独立网页端口，如 8080 → http://局域网IP:8080/webs/html/<slug>
PAGE_PORT=
# 链接里显示的主机（IP 或主机名），留空则自动用本机局域网 IPv4
PAGE_HOST=
# 公网分享根地址（可选，优先于 PAGE_HOST/PAGE_PORT 生成链接，不改变内部监听）
# 如 GOST 公网 30079 → 内网 8080：PAGE_PUBLIC_BASE_URL=http://203.0.113.10:30079
# 仅填写协议、主机和可选端口；不要带 /webs/html/... 路径
PAGE_PUBLIC_BASE_URL=
# 独立网页端口的监听地址；局域网访问该端口可改为 0.0.0.0
PAGE_BIND=127.0.0.1

# ===== 图片生成（OpenAI 兼容 images 接口，也可在设置页「图片生成」修改）=====
# 如硅基流动 https://api.siliconflow.cn/v1（模型如 black-forest-labs/FLUX.1-schnell、
# Kwai-Kolors/Kolors），或任何 OpenAI 兼容图片服务
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# 默认尺寸（宽x高），常用 1024x1024 / 720x1280 / 1280x720
IMAGE_SIZE=1024x1024

# ===== 视觉模型（多模态识图，OpenAI 兼容 chat/completions + 图片输入，也可在设置页「视觉模型」修改）=====
# 独立于沟通模型与图片生成模型；未配置时收到图片仅保存、不识别
# 如 GPT-4o / 通义千问 VL（qwen-vl-max）等支持图片输入的多模态模型
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== 语音（OpenAI 兼容 TTS 接口，也可在设置页「语音」修改；未配置时前端用浏览器朗读）=====
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy

# ===== RAG 语义检索（OpenAI 兼容 embeddings 接口，未配置时自动降级为关键词搜索）=====
# 如硅基流动 https://api.siliconflow.cn/v1（模型如 BAAI/bge-m3）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== 联网搜索（可插拔提供方，也可在设置页「联网搜索」修改）=====
# duckduckgo（默认，免 key 开箱即用）/ searxng（自托管）/ serper（https://serper.dev）/ tavily（https://tavily.com）
SEARCH_PROVIDER=duckduckgo
SEARXNG_BASE_URL=
SERPER_API_KEY=
TAVILY_API_KEY=
