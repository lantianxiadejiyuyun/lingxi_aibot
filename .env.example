# Rust native process environment reference.
# Rust does not load this file automatically: export variables in your shell/service.
# For Docker Compose, use .env.docker.example instead.
LINGXI_DATA_DIR=data/rust
LINGXI_BIND=127.0.0.1:8000
LINGXI_ALLOW_PRIVATE_NETWORK=false
RUST_LOG=lingxi=info,tower_http=info

# Docker bundles Node 24 + the official SDK. For a native Rust process, install
# Node 24 and point LINGXI_FEISHU_SCRIPT to integrations/feishu/bridge.mjs.
# LINGXI_FEISHU_EMBEDDED=true
# LINGXI_FEISHU_NODE=/usr/local/bin/node
# LINGXI_FEISHU_SCRIPT=/absolute/path/integrations/feishu/bridge.mjs
# LINGXI_PUBLIC_URL=http://127.0.0.1:8000
# LINGXI_NAPCAT_WEBUI_URL=http://127.0.0.1:6099/webui/
# To let Lingxi administrators open a locally managed NapCat without copying
# its WebUI key, point to its config directory (read permission only is needed).
# LINGXI_NAPCAT_MANAGED=true
# LINGXI_NAPCAT_CONFIG_DIR=/absolute/path/napcat/config
# LINGXI_NAPCAT_WEBUI_INTERNAL_URL=http://127.0.0.1:6099

# Pass only for init/reset-password, then unset (minimum 12 characters).
# LINGXI_ADMIN_PASSWORD=
# Pass only when importing a v1 database into an empty v2 database.
# LINGXI_IMPORT_PASSWORD=

# Model credentials, QQ configuration and notification channels are saved
# through the web settings and encrypted with data/rust/master.key.
