# Rust native process environment reference.
# Rust does not load this file automatically: export variables in your shell/service.
# For Docker Compose, use .env.docker.example instead.
LINGXI_DATA_DIR=data/rust
LINGXI_BIND=127.0.0.1:8000
LINGXI_ALLOW_PRIVATE_NETWORK=false
RUST_LOG=lingxi=info,tower_http=info

# Pass only for init/reset-password, then unset (minimum 12 characters).
# LINGXI_ADMIN_PASSWORD=
# Pass only when importing a v1 database into an empty v2 database.
# LINGXI_IMPORT_PASSWORD=

# Model credentials, QQ configuration and notification channels are saved
# through the web settings and encrypted with data/rust/master.key.
