# Copy to .env for Rust/Vue Docker Compose. Never commit the actual .env.
LINGXI_BIND_HOST=127.0.0.1
LINGXI_PORT=8000
LINGXI_ALLOW_PRIVATE_NETWORK=true
LINGXI_IMAGE=lingxi:2.0.0
LINGXI_PUBLIC_URL=http://127.0.0.1:8000
LINGXI_FEISHU_EMBEDDED=true
RUST_LOG=lingxi=info,tower_http=info

# Dedicated QQ vector service (internal only).
# Set a random key and use the same key in QQ settings.
LINGXI_QDRANT_API_KEY=

# Unified NapCat: scripts/deploy.sh generates a fresh API token and OneBot config.
# Leave COMPOSE_PROFILES empty and MANAGED=false when using an external NapCat.
COMPOSE_PROFILES=napcat
LINGXI_NAPCAT_MANAGED=true
LINGXI_NAPCAT_DATA_DIR=./napcat
# Compose mounts only this directory's config/ read-only into the app.
# Administrators can log in to NapCat from Lingxi; no WebUI key is stored here.
LINGXI_NAPCAT_WEBUI_URL=http://127.0.0.1:6099/webui/
# Server-to-server WebUI authentication; this is distinct from the OneBot API.
LINGXI_NAPCAT_WEBUI_INTERNAL_URL=http://napcat:6099
LINGXI_NAPCAT_HTTP_URL=http://napcat:3000
LINGXI_NAPCAT_HTTP_TOKEN=
NAPCAT_BIND_IP=127.0.0.1
NAPCAT_WEBUI_PORT=6099

# Optional AstrBot management port binding.
ASTRBOT_BIND_IP=127.0.0.1

# For docker-compose.fnos.yml, set the NAS LAN IP and use port 18081.
# LINGXI_NAS_IP=192.168.1.10
# LINGXI_PORT=18081
# Set LINGXI_PUBLIC_URL, NAPCAT_BIND_IP and LINGXI_NAPCAT_WEBUI_URL to the NAS LAN address too.
# LINGXI_NAPCAT_DATA_DIR=/vol1/docker/lingxi_napcat/data  # reuse existing QQ login

# Pass LINGXI_ADMIN_PASSWORD from your shell only when running init/reset-password.
# No MySQL, Flask, Python runtime or global model API key is needed by the app.
