# 仅用于 Docker 首次安装：复制为根目录 .env，填写下面两个不同的强密码。
# 已有部署请保留原 .env 和编排文件，不要用此模板覆盖。
# 在项目目录执行 docker compose 时，自动选用快速安装编排。
COMPOSE_FILE=docker-compose.quickstart.yml

# 应用首次启动后，运行配置保存在 data/.env。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=ai_bot
MYSQL_DB=ai_bot

# 留空自动生成并保存到 data/.env；HTTP 访问使用 0。
SECRET_KEY=
SESSION_COOKIE_SECURE=0

# 启用提醒和定时任务。
SCHEDULER_ENABLED=1

# 容器内网页端口保持 8080。公网地址可在登录后的「设置 → 网页站点」填写。
PAGE_PORT=8080
PAGE_BIND=0.0.0.0
PAGE_PUBLIC_BASE_URL=
